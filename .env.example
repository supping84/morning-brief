# 이 파일을 .env 로 복사하고 키를 채우세요. 없는 키는 해당 섹션만 건너뜁니다 (Yahoo·RSS는 키 불필요)

# ── 종목 스크리너 (필수) ──
# 금융감독원 DART — https://opendart.fss.or.kr/ → 인증키 신청 (즉시 발급, 하루 2만 건)
DART_API_KEY=

# ── 거시지표 탭 (전부 선택) ──

# 한국수출입은행 환율 — https://www.koreaexim.go.kr/ir/HPHKIR020M01?apino=2&viewtype=C
EXIM_API_KEY=

# 한국은행 ECOS — https://ecos.bok.or.kr/api/#/
ECOS_API_KEY=

# FRED — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 네이버 뉴스 검색 (선택) — https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 텔레그램 발송 (앱 없이 받으려면 필수) ──
# 1) 텔레그램에서 @BotFather 검색 → /newbot → 봇 이름 정하면 토큰을 줌
# 2) 만든 봇과 대화 시작(아무 말이나 전송) → @userinfobot 에게 /start 하면 내 chat id 를 알려줌
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 텔레그램 메시지 맨 아래 붙일 핸드폰 페이지 주소 (선택)
APP_URL=https://claude.ai/artifact/8hnm5suENQf2Wf6YHyHGpa

# Claude 요약 (선택, 유료·월 수백 원) — 비워두면 템플릿만 출력
ANTHROPIC_API_KEY=

# 결과 파일 저장 폴더 (기본 out/)
OUT_DIR=out
